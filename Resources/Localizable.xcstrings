      }
    },
    "The selected drives are in use by %@. Are you sure you want to eject them?": {
      "comment": "Title for confirmation sheet when unmounting multiple drives that are in use. %@ is the display-ready name of the current DOS process.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolené disky používá hra %@. Opravdu je chcete vysunout?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected drives are in use by %@. Are you sure you want to eject them?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las unidades seleccionadas están en uso por %@. ¿Está seguro que desea expulsarlas?"
