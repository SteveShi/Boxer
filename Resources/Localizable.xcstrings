            "state": "translated",
            "value": "yyyy-MM-dd 'at' h.mm.ss a"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy-MM-dd 'at' h.mm.ss a"
          }
        }
      }
    },
