    },
    "You can use the drive once the import has completed or been cancelled.": {
      "comment": "Recovery suggestion shown when a drive cannot be mounted because it is busy being imported.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk můžete začít používat, jakmile bude import dokončen nebo zrušen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can use the drive once the import has completed or been cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede usar la unidad una vez la importación se haya completado o cancelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez utiliser le lecteur lorsque l’importation sera terminée ou annulée."
