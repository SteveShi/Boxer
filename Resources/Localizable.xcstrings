          }
        }
      }
    },
    "Your player data and changes to game files will become a permanent part of the gamebox. This operation cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will become a permanent part of the gamebox. This operation cannot be undone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše herní data a změny provedené v herních souborech se stanou trvalou součástí herního balíčku. Tuto operaci nelze vrátit zpět."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos de juego y cambios de los archivos de juego se volverán una parte permanente del gamebox. Esta operación no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données joueur et modifications aux fichiers de jeu vont définitivement faire partie de votre gamebox. Cette opération ne peut pas être annulée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will become a permanent part of the gamebox. This operation cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的玩家存档和对游戏文件的修改将永久合并到游戏盒中。此操作无法撤销。"
          }
        }
      }
    },
