        }
      }
    },
    "There are no free DOS drive letters remaining.": {
      "comment": "Error shown when all drive letters are already occupied.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro DOSové disky už nejsou k dispozici žádná volná písmena."
