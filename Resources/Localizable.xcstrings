    },
    "The name “%1$@” is already taken. Please choose another.": {
      "comment": "Error shown when user renames a gamebox to a name that already exists. %1$@ is the intended filename.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název “%1$@” se již používá. Zvolte prosím nějaký jiný."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name “%1$@” is already taken. Please choose another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre “%1$@” ya está ocupado. Por favor elija otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom « %1$@ » est déjà utilisé. Veuillez en choisir un autre."
          }
