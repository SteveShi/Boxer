      }
    },
    "The file “%@” was not located inside this gamebox.": {
      "comment": "Error message shown when trying to add a launcher pointing to a URL outside the gamebox. %@ is the display filename of the URL in question.\nError message shown when trying to set the target path of a gamebox to a file outside the gamebox. %@ is the display filename of the file in question.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor “%@” se v tomto herním balíčku nenachází."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file “%@” was not located inside this gamebox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo “%@” no fue ubicado dentro de este gamebox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier « %@ » ne se situe pas à l’intérieur de cette gamebox."
