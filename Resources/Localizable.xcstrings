    "Ejecting a drive while it is in use may cause programs that depend on the drive to crash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecting a drive while it is in use may cause programs that depend on the drive to crash."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysunutím používaného disku může dojít ke zhroucení her, které na tomto disku závisí."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsar una unidad mientras está en uso puede causar un fallo en los programas que dependen de la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éjection d’un lecteur en cours d’utilisation risque de planter les programmes en cours d’exécution qui dépendent de ce lecteur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecting a drive while it is in use may cause programs that depend on the drive to crash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在驱动器使用中强行弹出可能会导致依赖该驱动器的程序崩溃。"
          }
        }
      }
    },
