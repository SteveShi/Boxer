          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The MS-DOS prompt has encountered a serious error and must be relaunched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El símbolo del MS-DOS ha encontrado un serio error y debe ser reiniciado."
          }
