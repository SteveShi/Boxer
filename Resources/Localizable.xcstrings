    "yyyy-MM-dd 'at' h.mm.ss a": {
      "comment": "The date and time format to use for screenshot filenames. Literal strings (such as the 'at') should be enclosed in single quotes. The date order should not be changed when localizing unless really necessary, as this is important to maintain chronological ordering in alphabetical file listings. Note that some characters such as / and : are not permissible in filenames and will be stripped out or replaced.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy-MM-dd 'v' h.mm.ss a"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "yyyy-MM-dd 'at' h.mm.ss a"
          }
        },
