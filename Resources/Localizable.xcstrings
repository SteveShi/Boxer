    },
    "Your player data and changes to game files will be lost. This operation cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will be lost. This operation cannot be undone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijdete o herní data i změny provedené v herních souborech. Tuto operaci nelze vrátit zpět."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos de juego y cambios de los archivos de juego se perderán. Esta operación no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données joueur et modifications aux fichiers de jeu seront perdues. Cette opération ne peut pas être annulée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will be lost. This operation cannot be undone."
          }
