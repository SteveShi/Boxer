{
  "sourceLanguage": "en",
  "strings": {
    " does not contain any MS-DOS programs.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” neobsahuje žádný program pro MS-DOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” does not contain any MS-DOS programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no contiene programas MS-DOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne contient pas de programme MS-DOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” does not contain any MS-DOS programs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不包含任何 MS-DOS 程序。"
          }
        }
      }
    },
    " in macOS's %1$@ preferences.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro co nejlepší zážitek zaškrtněte možnost “Zapnout přístup pro asistenční zařízení” na panelu %1$@ macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the best experience, turn on “Enable access for assistive devices” in macOS’ %1$@ preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una mejor experiencia, active “Activar acceso para dispositivos de asistencia” en preferencias %1$@ de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une meilleure expérience, activez « Activer l’accès pour les périphériques d’aide » dans les préférences %1$@ de macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "For the best experience, turn on “Enable access for assistive devices” in macOS’s %1$@ preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "For the best experience, turn on “Enable access for assistive devices” in macOS’ %1$@ preferences."
          }
        }
      }
    },
    " is a Mac OS game. Boxer only supports MS-DOS games.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” je hra pro Mac OS. Boxer podporuje pouze hry pro MS-DOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Classic Mac OS game. Boxer only supports MS-DOS games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” es un juego de Mac OS. Boxer solo soporta juegos MS-DOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un jeu Mac OS Classic. Boxer supporte uniquement les jeux MS-DOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Classic Mac OS game. Boxer only supports MS-DOS games."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是 Classic Mac OS 游戏。Boxer 仅支持 MS-DOS 游戏。"
          }
        }
      }
    },
    " is a Mac+PC hybrid disc, which Boxer cannot import.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” je hybridní disk Mac+PC, který Boxer nedokáže naimportovat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Mac+PC hybrid disc, which Boxer cannot import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” es un disco híbrido Mac+PC, que Boxer no puede importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un disque hybride Mac+PC. Boxer ne peut pas l’importer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Mac+PC hybrid disc, which Boxer cannot import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是 Mac+PC 混合光盘，Boxer 无法直接导入。"
          }
        }
      }
    },
    " is a special OS X folder and not suitable for storing your DOS games.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” je speciální složka macOS, která se nehodí k ukládání vašich DOSových her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is a special macOS folder and not suitable for storing your DOS games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” es una carpeta especial de macOS y no es adecuada para almacenar sus juegos DOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est un dossier spécial macOS et n’est pas approprié au stockage de vos jeux DOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is a special macOS folder and not suitable for storing your DOS games."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”是 macOS 特殊系统文件夹，不适于存放 DOS 游戏。"
          }
        }
      }
    },
    " is a Windows game. Boxer only supports MS-DOS games.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” je hra pro Windows. Boxer podporuje pouze hry pro MS-DOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Windows game. Boxer only supports MS-DOS games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” es un juego de Windows. Boxer solo soporta juegos de MS-DOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un jeu Windows. Boxer supporte uniquement les jeux MS-DOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Windows game. Boxer only supports MS-DOS games."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是 Windows 游戏。Boxer 仅支持 MS-DOS 游戏。"
          }
        }
      }
    },
    " must also\n be enabled in OS X's %1$@ preferences.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na panelu %1$@ macOS musí být rovněž zaškrtnuta\nmožnost “Zapnout přístup pro asistenční zařízení”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Enable access for assistive devices” must also\n be enabled in macOS’s %1$@ preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Activar acceso para dispositivos de asistencia” debe estar también activado en preferencias %1$@ de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Activer l’accès pour les périphériques d’aide » doit également\n être activé dans les préférences %1$@ de macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Enable access for assistive devices” must also\n be enabled in macOS’s %1$@ preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“Enable access for assistive devices” must also\n be enabled in macOS’s %1$@ preferences."
          }
        }
      }
    },
    ".": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "MS-DOSu není dovoleno přistupovat k systémovým složkám macOS, jako je “%@”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MS-DOS is not permitted to access macOS system folders like “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MS-DOS no está permitido acceder a la carpetas de sistema macOS como “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MS-DOS n’a pas les droits d’accès aux dossiers système macOS tels que « %@ »."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MS-DOS is not permitted to access macOS system folders like “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MS-DOS is not permitted to access macOS system folders like “%@”."
          }
        }
      }
    },
    "\"%@\" does not contain any MS-DOS programs.": {
      "comment": "Error message shown when importing a folder with no executables in it. %@ is the display filename of the imported folder."
    },
    "\"%@\" is a Mac OS game. Boxer only supports MS-DOS games.": {
      "comment": "Error message shown when importing a folder that contains a Mac game. %@ is the display filename of the imported path."
    },
    "\"%@\" is a Mac+PC hybrid disc, which Boxer cannot import.": {
      "comment": "Error message shown when importing a hybrid Mac/PC CD. %@ is the display filename of the imported path."
    },
    "\"%@\" is a Windows game. Boxer only supports MS-DOS games.": {
      "comment": "Error message shown when importing a folder that contains a Windows-only game or Windows installer. %@ is the display filename of the imported path."
    },
    "“%@” is a Windows program. Boxer only supports MS-DOS programs.": {
      "comment": "Title of warning sheet after running a Windows-only executable. %@ is the original filename of the executable.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” je program pro Windows. Boxer podporuje pouze programy pro MS-DOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Windows program. Boxer only supports MS-DOS programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” es un programa Windows. Boxer solo soporta programas MS-DOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un programme Windows. Boxer supporte uniquement les programmes MS-DOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a Windows program. Boxer only supports MS-DOS programs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是 Windows 程序。Boxer 仅支持 MS-DOS 程序。"
          }
        }
      }
    },
    "“%@” is not a valid joystick type.": {
      "comment": "Format for error message when choosing an unrecognised joystick type. %@ is the classname of the chosen joystick type.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” není platný typ joysticku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid joystick type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” no es un tipo de joystick valido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un type de joystick valide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is not a valid joystick type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是有效的手柄类型。"
          }
        }
      }
    },
    "“%1$@” contains game data for a different game.": {
      "comment": "Error message shown when importing a folder that has missing drives. %1$@ is the display filename of the imported path.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” obsahuje herní data pro jinou hru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” contains game data for a different game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” contiene datos de juego de un juego diferente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » contient des données de jeu pour un jeu différent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” contains game data for a different game."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”包含其他游戏的数据。"
          }
        }
      }
    },
    "“%1$@” does not contain any suitable MT-32 ROMs.": {
      "comment": "Error message shown when Boxer could not find any valid MT-32 ROMs to import from the folder the user chose. %1$@ is the filename of the folder.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” neobsahuje žádné vhodné ROM MT-32."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” does not contain any suitable MT-32 ROMs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” no contiene ROMs MT-32 adecuadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » ne contient pas de ROM MT-32 appropriée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” does not contain any suitable MT-32 ROMs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”不包含任何适用的 MT-32 ROM。"
          }
        }
      }
    },
    "\"%1$@\" is a special OS X folder and not suitable for storing your DOS games.": {
      "comment": "Error message shown after choosing a reserved folder as the location for the DOS Games folder. %1$@ is the display name of the folder."
    },
    "“%1$@” is from a different MT-32 model than the existing %2$@.": {
      "comment": "Bold error message shown when user attempts to add a PCM ROM that doesn't match an already-imported control ROM or vice-versa. %1$@ is the filename of the new ROM, and %2$@ is the proper term for that kind of ROM (control or PCM).",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” náleží k jinému modelu MT-32 než existující %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is from a different MT-32 model than the existing %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” es un modelo MT-32 diferente al actual %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » provient d’un modèle de MT-32 différent que le ROM %2$@ existante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is from a different MT-32 model than the existing %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”与现有的 %2$@ 来自不同的 MT-32 型号。"
          }
        }
      }
    },
    "“%1$@” is not a valid MT-32 ROM.": {
      "comment": "Error message shown when the file the user selected was not a valid MT-32 ROM. %1$@ is the filename of the file.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” není platnou ROM MT-32."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is not a valid MT-32 ROM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” no es una ROM MT-32 valida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » n’est pas une ROM MT-32 valide."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is not a valid MT-32 ROM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”不是有效的 MT-32 ROM。"
          }
        }
      }
    },
    "“%1$@” requires extra files that are currently unavailable.": {
      "comment": "Error message shown when importing a folder that has missing drives. %1$@ is the display filename of the imported path.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” vyžaduje další soubory, které jsou momentálně nedostupné."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” requires extra files that are currently unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” necesita archivos extra que actualmente no están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » nécessite des fichiers supplémentaires qui sont actuellement indisponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” requires extra files that are currently unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”需要当前不可用的附加文件。"
          }
        }
      }
    },
    "\"Enable access for assistive devices\" must also\n be enabled in OS X's %1$@ preferences.": {
      "comment": "Explanatory message shown in Keyboard Preferences if Boxer is not able to install its hotkey capture event tap on OS X 10.8 and below. %1$@ is the localized name of the Accessibility preferences pane."
    },
    "(If an F1, F2 etc. key still behaves as an OS X hotkey, then hold down Fn while pressing the key.)": {
      "comment": "Additional help displayed below hotkey capture toggle on Keyboard Preferences pane.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "(Chová-li se stále klávesa F1, F2 atd. jako klávesová zkratka macOS, pak podržte Fn a teprve poté stiskněte klávesu.)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(If an F1, F2 etc. key still behaves as a macOS hotkey, then hold down Fn while pressing the key.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Si una tecla F1, F2 etc. se comporta como una tecla de acceso rápido de macOS, mantenga pulsada la tecla Fn mientras pulsa la tecla.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(si une touche F1, F2 etc. agit en tant que raccourci clavier macOS, maintenez enfoncé Fn lorque la touche est appuyée.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "(If an F1, F2 etc. key still behaves as a macOS hotkey, then hold down Fn while pressing the key.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(If an F1, F2 etc. key still behaves as a macOS hotkey, then hold down Fn while pressing the key.)"
          }
        }
      }
    },
    "%@ (ejected)": {
      "comment": "Description format for inactive drives. %@ is the original description of the drive (e.g. 'CD-ROM', 'hard disk' etc.)",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (vysunuto)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (ejected)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (expulsado)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (éjecté)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (ejected)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (ejected)"
          }
        }
      }
    },
    "%@ (Paused)": {
      "comment": "Window title format when session is paused. %@ is the regular title of the window.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (pozastaveno)"
          }
        },
        "en": {
