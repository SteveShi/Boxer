    "If this continues to occur after relaunching, please send us an error report.": {
      "comment": "Suggestion text shown in alert when an unrecoverable emulation error is encountered.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se tato chyba projeví i po opětovném spuštění, pošlete nám prosím chybové hlášení."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this continues to occur after relaunching, please send us an error report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto vuelve a ocurrir después del reinicio, por favor envíenos un informe de error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la même erreur se reproduit après avoir relancé le jeu, envoyez-nous un rapport d’erreur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "If this continues to occur after relaunching, please send us an error report."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "If this continues to occur after relaunching, please send us an error report."
          }
        }
      }
    },
    "If you cannot play this game in OS X, you may be able to play it in a Classic Mac OS emulator instead. For more help, click the ? button.": {
      "comment": "Informative text of warning sheet after importing a Mac application.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se vám nedaří spustit tuto hru v macOS, budete ji možná schopni zprovoznit v emulátoru klasického Mac OSu. Pro více informací klikněte na tlačítko otazníku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot play this game in macOS, you may be able to play it in a Classic Mac OS emulator instead. For more help, click the ? button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no puede jugar este juego en macOS, puede jugar en su lugar en un emulador de Mac OS clásico. Para más ayuda haga clic en el botón ?."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ne pouvez pas jouer à ce jeu sous macOS, vous pourrez peut-être y jouer avec un émulateur Mac OS Classic. Pour plus d’aide, cliquez sur le bouton ?."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot play this game in macOS, you may be able to play it in a Classic Mac OS emulator instead. For more help, click the ? button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot play this game in macOS, you may be able to play it in a Classic Mac OS emulator instead. For more help, click the ? button."
          }
        }
      }
    },
