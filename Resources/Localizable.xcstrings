          }
        }
      }
    },
    "You will need to a find a matching %1$@, or else replace both ROMs with ones from the same model.": {
      "comment": "Explanatory text shown when user attempts to add a PCM ROM that doesn’t match an already-imported control ROM, or vice-versa. %1$@ is the proper term for that kind of ROM.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budete muset najít odpovídající %1$@ nebo nahradit obě ROM verzemi patřícími ke stejnému modelu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will need to a find a matching %1$@, or else replace both ROMs with ones from the same model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita encontrar %1$@ adecuada, o sino reemplazar ambas ROMs con unas del mismo modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez trouver une %1$@ qui correspond, ou bien remplacer les deux ROM par celles d’un même modèle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "You will need to a find a matching %1$@, or else replace both ROMs with ones from the same model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您需要找到匹配的 %1$@，或将两个 ROM 都替换为同一型号的 ROM。"
          }
        }
      }
    },
    "Your changes to accessibility permissions will take effect next time Boxer is launched.": {
      "comment": "Help message shown on Keyboard Preferences panel when Boxer has been given extra accessibility permission but must restart for it to take effect.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny v nastavení funkce Zpřístupnění vejdou v platnost při příštím spuštění Boxeru."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes to accessibility permissions will take effect next time Boxer is launched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cambios en los permisos de accesibilidad tendrán efecto la próxima vez que se inicie Boxer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications concernant les accès d’accessibilité prendront effet au prochain lancement de Boxer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes to accessibility permissions will take effect next time Boxer is launched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您对辅助功能权限所做的更改将在下次启动 Boxer 时生效。"
          }
        }
      }
    },
    "Your player data and changes to game files will be lost. This operation cannot be undone.": {
      "comment": "Informative text of confirmation when reverting the current session to its original state.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijdete o herní data i změny provedené v herních souborech. Tuto operaci nelze vrátit zpět."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will be lost. This operation cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos de juego y cambios de los archivos de juego se perderán. Esta operación no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données joueur et modifications aux fichiers de jeu seront perdues. Cette opération ne peut pas être annulée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will be lost. This operation cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的玩家存档和对游戏文件的修改都将丢失。此操作无法撤销。"
          }
        }
      }
    },
    "Your player data and changes to game files will become a permanent part of the gamebox. This operation cannot be undone.": {
      "comment": "Informative text of confirmation when merging shadowed changes for the current session.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše herní data a změny provedené v herních souborech se stanou trvalou součástí herního balíčku. Tuto operaci nelze vrátit zpět."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will become a permanent part of the gamebox. This operation cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos de juego y cambios de los archivos de juego se volverán una parte permanente del gamebox. Esta operación no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données joueur et modifications aux fichiers de jeu vont définitivement faire partie de votre gamebox. Cette opération ne peut pas être annulée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Your player data and changes to game files will become a permanent part of the gamebox. This operation cannot be undone."
          }
