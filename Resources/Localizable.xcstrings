    "This ensures that OS X hotkeys won't interfere with %1$@'s game controls.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ensures that macOS hotkeys won’t interfere with %1$@’s game controls."
