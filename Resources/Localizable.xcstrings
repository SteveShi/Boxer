    },
    "The file “%1$@” could not be read.": {
      "comment": "Error shown when a drive's source does not exist or could not be accessed. %1$@ is the filename of the drive's source.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor “%1$@” se nepodařilo přečíst."
          }
