            "state": "translated",
            "value": "%@ (Paused)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Pausado)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (en pause)"
          }
        },
        "pt-BR": {
          "stringUnit": {
