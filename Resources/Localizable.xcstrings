    "Your changes to accessibility permissions will take effect next time Boxer is launched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes to accessibility permissions will take effect next time Boxer is launched."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny v nastavení funkce Zpřístupnění vejdou v platnost při příštím spuštění Boxeru."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cambios en los permisos de accesibilidad tendrán efecto la próxima vez que se inicie Boxer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
