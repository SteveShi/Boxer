    },
    "This ensures that OS X hotkeys won't interfere with %1$@'s game controls.": {
      "comment": "Informative text of alert shown if the application is not yet trusted for accessibility access on 10.9 and above. %1$@ is the name of the application.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To zajistí, že klávesové zkratky macOS nebudou kolidovat s ovládáním ve hře %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ensures that macOS hotkeys won’t interfere with %1$@’s game controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto garantiza que las teclas de acceso rápido de macOS no interfieran con los controles de juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche les raccourcis clavier de macOS d’interférer avec les commandes du jeu %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This ensures that macOS hotkeys won’t interfere with %1$@’s game controls."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可确保 macOS 快捷键不会干扰 %1$@ 的游戏操作按键。"
          }
        }
      }
    },
    "This feature requires Boxer to be given accessibility control in %1$@ Preferences.": {
      "comment": "Explanatory message shown in Keyboard Preferences if Boxer is not able to install its hotkey capture event tap on OS X 10.9 and up. %1$@ is the localized name of the Security & Privacy preferences pane.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvůli této funkci musíte Boxeru povolit ovládání vašeho počítače na panelu %1$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature requires Boxer to be given accessibility control in %1$@ Preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta característica requiere que Boxer reciba control de accesibilidad en preferencias de %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite que Boxer ait un accès d’accessibilité dans les préférences %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature requires Boxer to be given accessibility control in %1$@ Preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
