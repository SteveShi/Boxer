          }
        }
      }
    },
    "The image “%1$@” could not be imported because Boxer was unable to determine its source files.": {
      "comment": "Error shown when drive bundle importing fails because the CUE file could not be parsed. %1$@ is the display title of the drive.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz “%1$@” se nepodařilo naimportovat, protože Boxer nedokázal určit jeho zdrojové soubory."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image “%1$@” could not be imported because Boxer was unable to determine its source files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen “%1$@” no se puede importar debido a que Boxer no puede determinar los archivos fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image « %1$@ » n’a pas pu être importée parce que Boxer a été incapable de déterminer ses fichiers source."
          }
        },
        "pt-BR": {
          "stringUnit": {
