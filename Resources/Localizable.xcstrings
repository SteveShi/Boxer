    "You can insert the disc into a Windows PC instead, and copy the DOS version of the game from there to your Mac. For more help, click the ? button.": {
      "comment": "Informative text of warning sheet when importing a hybrid Mac/PC CD.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste tento disk raději vložit do Windows PC a DOSovou verzi hry z něj překopírovat do Macu. Pro více informací klikněte na tlačítko otazníku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can insert the disc into a Windows PC instead, and copy the DOS version of the game from there to your Mac. For more help, click the ? button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede insertar el disco en su lugar en un PC Windows, y copiar la versión DOS del juego desde su Mac. Para más ayuda haga clic en el botón ?."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insérez plutôt le disque dans un PC Windows et copiez la version DOS du jeu de ce PC vers votre Mac. Pour plus d’aide, cliquez sur le bouton ?."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "You can insert the disc into a Windows PC instead, and copy the DOS version of the game from there to your Mac. For more help, click the ? button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以先将光盘放入 Windows 电脑，然后将游戏的 DOS 版本复制到 Mac 上。如需更多帮助，请点击“？”按钮。"
          }
        }
      }
    },
    "You can run this game in a Windows emulator instead. For more help, click the ? button.": {
      "comment": "Informative text of warning sheet after importing a Windows-only game.",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste tuto hru raději spustit v emulátoru Windows. Pro více informací klikněte na tlačítko otazníku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can run this game in a Windows emulator instead. For more help, click the ? button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ejecutar este juego en su lugar en un emulador de Windows. Para más ayuda haga clic en el botón ?."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez plutôt ce jeu dans un émulateur Windows. Pour plus d’aide, cliquez sur le bouton ?."
          }
        },
