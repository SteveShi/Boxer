    "276.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Boxer does not come with the ROMs needed to play\\nMT-32 music, as these are not legal to distribute.\"; ObjectID = \"276\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Boxer does not come with the ROMs needed to play\nMT-32 music, as these are not legal to distribute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxer no viene con las ROMs necesarias para reproducir\nmúsica MT-32, ya que no es legal distribuirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ROM nécessaires pour jouer les musiques avec le\nMT-32 ne sont pas fournies. Il est illégal de les distribuer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Boxer não vem com as ROMs necessárias para\n tocar música do MT-32, pois é ilegal a distribuição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于版权分发限制，Boxer 未内置播放\nMT-32 音乐所需的 ROM 文件。"
          }
        }
      }
    },
    "278.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"But if one should stumble across MT-32 ROMs on the internet, then acccidentally download them, one could drag them onto this shelf to bring one’s MT-32 games to life.\"; ObjectID = \"278\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "But if one should stumble across MT-32 ROMs on the internet, then acccidentally download them, one could drag them onto this shelf to bring one’s MT-32 games to life."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pero si se encuentra con ROMs MT-32 en internet, entonces descárguelos accidentalmente, podrá arrastrarlos a esta estantería para llevar los juegos MT-32 a la vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais si quelqu’un tombait par hasard sur les ROM MT-32 sur Internet et les téléchargeait accidentellement, cette personne pourrait les déposer sur cette étagère afin de donner vie aux jeux MT-32."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porém se você se esbarrar pelas ROMs do MT-32 na internet, e acidentalmente baixa-las, arrasta-las para cá trarão uma vida nova ao jogos com MT-32"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您从其他渠道获取了 MT-32 ROM，只需将其拖入此书架即可激活真实的 MT-32 游戏音效。"
          }
        }
      }
    },
