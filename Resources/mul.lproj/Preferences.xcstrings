    "76.title": {
      "comment": "Class = \"NSButtonCell\"; title = \"Start up games in Full Screen mode\"; ObjectID = \"76\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Start up games in Full Screen mode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar juegos en modo pantalla completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer le jeu en mode plein écran"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar os jogos em tela cheia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏模式启动游戏"
          }
        }
      }
    },
    "77.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"You can switch to and from Full Screen at any time from the View menu or by pressing Cmd-F.\"; ObjectID = \"77\";",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch to and from Full Screen at any time from the View menu or by pressing ⌘-F."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede cambiar desde pantalla completa en cualquier momento desde el menú visualización o pulsando Cmd-F."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez basculer ce mode à partir du menu Présentation ou en appuyant sur Cmd-F."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar para tela cheia e voltar usando o menu Exibir ou pressionando Cmd+F."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以随时从“显示”菜单或按 ⌘-F 切换全屏状态。"
          }
        }
      }
    },
    "78.title": {
      "comment": "Class = \"NSButtonCell\"; title = \"Always use 4:3 aspect ratio\"; ObjectID = \"78\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Always use 4:3 aspect ratio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar siempre relación de aspecto 4:3"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours utiliser le format d’image 4:3"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre usar a proporção 4:3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终保持 4:3 画面比例"
          }
        }
      }
    },
    "79.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"When enabled, games will be stretched to match their original aspect ratio on old PC monitors.\"; ObjectID = \"79\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "When enabled, games will be stretched to match their original aspect ratio on old PC monitors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activar, los juegos se estirarán para coincidir con su relación de aspecto original en los monitores de PC antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étire le format d’image des jeux afin de correspondre au format des anciens moniteurs PC."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, os jogos serão esticados para bater com a proporção dos monitores antigos dos PCs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，游戏画面将拉伸以匹配老式 PC 显示器的原始宽高比。"
          }
        }
      }
    },
