    "369.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Prevents macOS system hotkeys from interfering with the keyboard controls in your DOS games.\"; ObjectID = \"369\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Prevents macOS system hotkeys from interfering with the keyboard controls in your DOS games."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que las teclas de acceso del sistema macOS interfieran con los controles de teclado en los juegos DOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche les raccourcis clavier de macOS d’interférer avec les commandes clavier de vos jeux DOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede dos atalhos do macOS interferirem com os controles de teclado dos seus jogos do DOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止 macOS 系统快捷键干扰 DOS 游戏的键盘控制。"
          }
        }
      }
    },
    "373.title": {
