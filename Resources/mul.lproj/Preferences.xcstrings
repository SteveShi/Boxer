            "value": "As an MT-32 owner, you are also a person of taste and distinction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como propietario de una MT-32, también es una persona de gusto y distinción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En tant que possesseur d’un MT-32, vous êtes également une personne raffinée et distinguée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
