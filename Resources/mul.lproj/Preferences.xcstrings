    "319.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Some games will print secret messages on the MT-32’s LCD panel. When enabled, Boxer will display these on-screen.\"; ObjectID = \"319\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Some games will print secret messages on the MT-32’s LCD panel. When enabled, Boxer will display these on-screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos juegos escribirán mensajes secretos en el panel LCD de MT-32. Al activar, Boxer los visualizará en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains jeux afficheront des messages secrets sur l’écran LCD du MT-32. Si l’option est activée, Boxer affichera ces messages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns jogos exibem mensagens secretas na tela LCD do MT-32. Quando ativado, o Boxer exibirá essas mensagens na tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分游戏会在 MT-32 液晶面板上输出提示消息。启用后，Boxer 将在屏幕上显示这些提示。"
          }
        }
      }
    },
    "333.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Music in supporting games will be played through your Roland MT-32 Sound Module.\"; ObjectID = \"333\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Music in supporting games will be played through your Roland MT-32 Sound Module."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música de los juegos compatibles se reproducirá a través de su módulo de sonido Roland MT-32."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les jeux supportant la musique, elle sera jouée par votre module sonore Roland MT-32."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Músicas dos jogos suportados serão tocadas através do Módulo de Som do Roland MT-32."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的游戏将通过您的 Roland MT-32 声音模块播放音乐。"
          }
        }
      }
    },
    "334.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"As an MT-32 owner, you are also a person of taste and distinction.\"; ObjectID = \"334\";",
      "extractionState": "extracted_with_value",
