    "Adaptive scanline deinterlacing for FMV cutscenes and seamless mounting of multi-track MDS/MDF images.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive scanline deinterlacing for FMV cutscenes and seamless mounting of multi-track MDS/MDF images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持全动态过场动画自适应去隔行平滑处理，并原生兼容多音轨 MDS/MDF 光盘镜像无损挂载。"
          }
        }
      }
