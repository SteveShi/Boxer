        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全新集成 Nuked-SC55 仿真插件，自动扫描 Application Support 目录下的 ROM 文件，带来极具临场感的通用 MIDI 乐声。"
          }
        }
      }
    },
    "FMV Deinterlacing & MDS Disc Support": {
      "localizations": {
