    "Upgraded to the latest DOSBox-Staging 0.83.0 engine with modern C++20 architecture, native ARM64 dynamic core, and improved FAT filesystem compatibility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgraded to the latest DOSBox-Staging 0.83.0 engine with modern C++20 architecture, native ARM64 dynamic core, and improved FAT filesystem compatibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仿真核心全面升级至 DOSBox-Staging 0.83.0，深度适配 C++20 架构、原生 ARM64 动态重译核心与全新 FAT 文件系统，仿真精度与稳定性大幅提升。"
          }
        }
      }
    },
    "Physical Drive Noise Emulation": {
      "localizations": {
