    "Authentic acoustic simulation of vintage 3.5\" floppy disk and mechanical hard drive head seek sounds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentic acoustic simulation of vintage 3.5\" floppy disk and mechanical hard drive head seek sounds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逼真模拟复古 3.5 英寸软盘与机械硬盘的磁头寻道与转动音效，重温经典硬件声音记忆。"
          }
        }
      }
    },
