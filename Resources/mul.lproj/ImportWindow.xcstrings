    "454.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Drop a CD-ROM, game folder or disc image\\nand Boxer will import it into a new gamebox. \"; ObjectID = \"454\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Drop a CD-ROM, game folder or disc image\nand Boxer will import it into a new gamebox. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un CD-ROM, carpeta de juego o imagen de disco\ny Boxer lo importará en un nuevo gamebox. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un CD-ROM, un dossier de jeu ou une image disque\net Boxer l’importera en tant que nouvelle gamebox. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o CD-ROM, pasta do jogo ou imagem de disco\ne o Boxer importará para uma nova gamebox. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入 CD-ROM、游戏文件夹或光盘映像，\nBoxer 将自动将其导入为新的游戏盒。"
          }
        }
      }
    },
    "456.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Boxer will now launch an\\ninstaller to set up this game.\"; ObjectID = \"456\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Boxer will now launch an\ninstaller to set up this game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxer ejecutará ahora un\ninstalador para configurar este juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxer va maintenant lancer un\nprogramme d’installation pour configurer ce jeu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Boxer vai executar agora\no instalador deste jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Boxer 即将启动安装程序以配置此游戏。"
          }
        }
      }
