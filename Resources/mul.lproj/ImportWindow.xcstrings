    "450.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Please wait while Boxer\\nscans your game.\"; ObjectID = \"450\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Please wait while Boxer\nscans your game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor espere mientras Boxer\nescanea su juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez patienter pendant que\nBoxer analyse votre jeu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere enquanto o Boxer\nlê seu jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍候，Boxer 正在扫描您的游戏。"
          }
        }
      }
    },
