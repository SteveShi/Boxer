          "stringUnit": {
            "state": "new",
            "value": "Instruct your DOS program to print to LPT1 using A4 paper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure su programa DOS para imprimir por LPT1 usando papel A4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez à votre programme DOS d’imprimer vers LPT1 avec du papier A4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrua seu programa do DOS para imprimir na LPT1 usando folha A4."
