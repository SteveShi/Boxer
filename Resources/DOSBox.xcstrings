    "SHELL_CMD_DATE_HELP_LONG" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATE [[/T] [/H] [/S] | MM-DD-YYYY]\n  MM-DD-YYYY: new date to set\n  /S:         Permanently use host time and date as DOS time\n  /F:         Switch back to DOSBox internal time (opposite of /S)\n  /T:         Only display date\n  /H:         Synchronize with host\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATE [[/T] [/H] [/S] | MM-JJ-AAAA]\n  MM-JJ-AAAA: Nouvelle date à configurer\n  /S:         Utilise l'heure et la date de l'hôte pour l'heure de DOS\n  /F:         Retourne à l'heure interne de DOSBox (opposé de /S)\n  /T:         Affiche uniquement la date\n  /H:         Synchronise avec l'hôte\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATE [[/T] [/H] [/S] | MM-DD-YYYY]\n  MM-DD-YYYY: new date to set\n  /S:         Permanently use host time and date as DOS time\n  /F:         Switch back to DOSBox internal time (opposite of /S)\n  /T:         Only display date\n  /H:         Synchronize with host\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATE [[/T] [/H] [/S] | MM-DD-YYYY]\n  MM-DD-YYYY: new date to set\n  /S:         Permanently use host time and date as DOS time\n  /F:         Switch back to DOSBox internal time (opposite of /S)\n  /T:         Only display date\n  /H:         Synchronize with host\n"
