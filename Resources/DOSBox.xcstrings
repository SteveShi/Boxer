    "PROGRAM_CONFIG_USAGE" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:    \u001b[34;1mconfig -get [section] [property]\u001b[0m\n          \u001b[34;1mconfig -set [section] [property] [value]\u001b[0m\n\t\t \nExamples: \u001b[32;1mconfig -get cpu cycles\u001b[0m shows the current CPU cycles setting.\n          \u001b[32;1mconfig -set cpu core dynamic\u001b[0m turns on dynamic core emulation.\n\t\t  \nYou can also omit \u001b[34;1mconfig -get/set [section]\u001b[0m entirely:\n          \u001b[32;1mcycles\u001b[0m shows the current CPU cycles setting.\n          \u001b[32;1mcore dynamic\u001b[0m turns on dynamic core emulation.\n\nNote that some configuration settings cannot be modified\nwhile the DOS session is running.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso:    \u001b[34;1m  config -get [sección] [propiedad]\u001b[0m\n          \u001b[34;1mconfig -set [sección] [propiedad] [valor]\u001b[0m\n\t\t \nEjemplos: \u001b[32;1mconfig -get cpu cycles\u001b[0m muestra la configuración actual de ciclos de la CPU.\n          \u001b[32;1mconfig -set cpu core dynamic\u001b[0m activa la emulación dinámica del núcleo.\n\t\t  \nTambién puede omitir por completo \u001b[34;1mconfig -get/set [sección]\u001b[0m:\n          \u001b[32;1mcycles\u001b[0m muestra la configuración actual de ciclos de la CPU.\n          \u001b[32;1mcore dynamic\u001b[0m activa la emulación dinámica del núcleo.\n\nTenga en cuenta que algunas configuraciones no se pueden modificar mientras una sesión DOS se está ejecutando.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage :    \u001b[34;1mconfig -get [section] [propriété]\u001b[0m\n\t\t   \u001b[34;1mconfig -set [section] [propriété] [valeur]\u001b[0m\n\t\t \nExemples : \u001b[32;1mconfig -get cpu cycles\u001b[0m affiche le paramètre actuel des cycles CPU.\n\t\t   \u001b[32;1mconfig -set cpu core dynamic\u001b[0m active l'émulation de coeur dynamique.\n\t\t  \nVous pouvez également omettre \u001b[34;1mconfig -get/set [section]\u001b[0m complètement :\n\t\t   \u001b[32;1mcycles\u001b[0m affiche le paramètre actuel des cycles CPU.\n\t\t   \u001b[32;1mcore dynamic\u001b[0m active l'émulation de coeur dynamique.\n\nRemarque : certains paramètres de configuration ne peuvent pas être modifiés\nlorsque la session DOS est en cours d'exécution.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:    \u001b[34;1mconfig -get [section] [property]\u001b[0m\n          \u001b[34;1mconfig -set [section] [property] [value]\u001b[0m\n\t\t \nExamples: \u001b[32;1mconfig -get cpu cycles\u001b[0m shows the current CPU cycles setting.\n          \u001b[32;1mconfig -set cpu core dynamic\u001b[0m turns on dynamic core emulation.\n\t\t  \nYou can also omit \u001b[34;1mconfig -get/set [section]\u001b[0m entirely:\n          \u001b[32;1mcycles\u001b[0m shows the current CPU cycles setting.\n          \u001b[32;1mcore dynamic\u001b[0m turns on dynamic core emulation.\n\nNote that some configuration settings cannot be modified\nwhile the DOS session is running.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:    \u001b[34;1mconfig -get [section] [property]\u001b[0m\n          \u001b[34;1mconfig -set [section] [property] [value]\u001b[0m\n\t\t \nExamples: \u001b[32;1mconfig -get cpu cycles\u001b[0m shows the current CPU cycles setting.\n          \u001b[32;1mconfig -set cpu core dynamic\u001b[0m turns on dynamic core emulation.\n\t\t  \nYou can also omit \u001b[34;1mconfig -get/set [section]\u001b[0m entirely:\n          \u001b[32;1mcycles\u001b[0m shows the current CPU cycles setting.\n          \u001b[32;1mcore dynamic\u001b[0m turns on dynamic core emulation.\n\nNote that some configuration settings cannot be modified\nwhile the DOS session is running.\n"
          }
        }
      }
    },
