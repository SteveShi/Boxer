    "PROGRAM_CONFIG_GET_SYNTAX" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:   \u001b[34;1mconfig -get [section] [property]\u001b[0m\n\nExample: \u001b[32;1mconfig -get cpu cycles\u001b[0m shows the current cycles setting.\n\nYou can also omit \u001b[34;1mconfig -get [section]\u001b[0m entirely:\n         \u001b[32;1mcycles\u001b[0m shows the current CPU cycles setting.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso:     \u001b[34;1mconfig -get [sección] [propiedad]\u001b[0m\n\nEjemplo: \u001b[32;1mconfig -get cpu cycles\u001b[0m muestra la configuración actual de ciclos.\n\nTambién puede omitir por completo \u001b[34;1mconfig -get [sección]\u001b[0m:\n         \u001b[32;1mcycles\u001b[0m muestra la configuración actual de ciclos de la CPU.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage :   \u001b[34;1mconfig -get [section] [propriété]\u001b[0m\n\nExemple : \u001b[32;1mconfig -get cpu cycles\u001b[0m affiche le paramètre actuel des cycles CPU.\n\nVous pouvez également omettre \u001b[34;1mconfig -get [section]\u001b[0m complètement :\n\t\t  \u001b[32;1mcycles\u001b[0m affiche le paramètre actuel des cycles CPU.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:   \u001b[34;1mconfig -get [section] [property]\u001b[0m\n\nExample: \u001b[32;1mconfig -get cpu cycles\u001b[0m shows the current cycles setting.\n\nYou can also omit \u001b[34;1mconfig -get [section]\u001b[0m entirely:\n         \u001b[32;1mcycles\u001b[0m shows the current CPU cycles setting.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
