    "SHELL_CMD_CHDIR_HINT_3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are on drive Z, which has no folders.\nChange to one of your own drives first by typing \u001b[1;32mC:\u001b[0m\nTo add a drive, \u001b[1;34mdrag a folder into the DOS window\u001b[0m or select \u001b[1;32mAdd DOS Drive\u001b[0m\nin the \u001b[1;32mDrives\u001b[0m menu.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en la unidad Z, la cual no tiene carpetas.\nPrimero cambie a una de sus unidades escribiendo \u001b[1;32mC:\u001b[0m\nPara añadir una unidad, \u001b[1;34marrastre una carpeta a la ventana DOS\u001b[0m\no seleccione \u001b[1;32mAñadir unidad DOS\u001b[0m en el menú \u001b[1;32mUnidades\u001b[0m.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sur lecteur Z. Il ne contient pas de dossier.\nChangez de lecteur vers un des vôtres en tapant \u001b[1;32mC:\u001b[0m\nPour ajouter un lecteur, \u001b[1;34mdéposez un dossier dans la fenêtre DOS\u001b[0m ou\nsélectionnez \u001b[1;32mAjouter un lecteur DOS\u001b[0m dans le menu \u001b[1;32mLecteurs\u001b[0m.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are on drive Z, which has no folders.\nChange to one of your own drives first by typing \u001b[1;32mC:\u001b[0m\nTo add a drive, \u001b[1;34mdrag a folder into the DOS window\u001b[0m or select \u001b[1;32mAdd DOS Drive\u001b[0m\nin the \u001b[1;32mDrives\u001b[0m menu.\n"
