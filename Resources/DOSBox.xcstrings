        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso:      \u001b[34;1mcopy [ruta/a/archivo] [ruta/a/destino]\u001b[0m\n\nEjemplos: \u001b[32;1mcopy d:/game.exe c:/games/\u001b[0m copiarÃ¡ \"game.exe\" de la unidad D\n          a la carpeta \"games\" de la unidad C.\n\t\t  \n          \u001b[32;1mcopy d:/old.exe c:/games/new.exe\u001b[0m copiarÃ¡ \"old.exe\" de la unidad D\n          a la carpeta \"games\" de la unidad C, nombrando la nueva copia como\n          \"new.exe\".\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage :    \u001b[34;1mcopy [chemin/du/fichier] [chemin/de/destination]\u001b[0m\n\nExemples : \u001b[32;1mcopy d:/jeu.exe c:/jeux/\u001b[0m copiera \"jeu.exe\" du lecteur D\n\t\t   vers le dossier \"jeux\" du lecteur C.\n\t\t  \n\t\t   \u001b[32;1mcopy d:/ancien.exe c:/jeux/nouveau.exe\u001b[0m copiera \"ancien.exe\" du\n\t\t   lecteur D vers le dossier \"jeux\" du lecteur C, en nommant la\n\t\t   nouvelle copie \"nouveau.exe\".\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mcopy [path/to/file] [path/to/destination]\u001b[0m\n\nExamples: \u001b[32;1mcopy d:/game.exe c:/games/\u001b[0m will copy \"game.exe\" from drive D\n          to the \"games\" folder of drive C.\n\t\t  \n          \u001b[32;1mcopy d:/old.exe c:/games/new.exe\u001b[0m will copy \"old.exe\" from drive D\n          to the \"games\" folder of drive C, naming the new copy as \"new.exe\".\n"
