          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "  Utilisez \u001b[31mF12\u001b[37m pour dÃ©finir la sortie composite sur ON, OFF, ou AUTO (par dÃ©faut).\n  \u001b[31m(Alt-)F11\u001b[37m modifie la teinte ;\n  \u001b[31mCtrl-Alt-F11\u001b[37m sÃ©lectionne le modÃ¨le CGA dÃ©but/fin.\n"
