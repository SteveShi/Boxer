    "SHELL_CMD_CALL_HELP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a batch file from within another batch file.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un archivo por lotes desde otro archivo por lotes.\n"
