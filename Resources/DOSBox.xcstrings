    "MSCDEX_ERROR_MULTIPLE_CDROMS" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CD-ROM emulation failure: Multiple CD-ROM drives must be mounted on contiguous drive letters.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error de emulación de CD-ROM: Las unidades de CD-ROM múltiples deben ser \nmontadas en letras de unidad contiguas.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec émulation CD-ROM : Les lettres des lecteurs CD-ROM doivent se suivre.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CD-ROM emulation failure: Multiple CD-ROM drives must be mounted on contiguous drive letters.\n"
          }
        },
