    "PROGRAM_IMGMOUNT_SPECIFY_GEOMETRY": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For \u001b[33mCD-ROM\u001b[0m images:   \u001b[34;1mimgmount [DOS drive letter] [\"Path/to/image.iso\"] -t cdrom\u001b[0m\n\nFor \u001b[33mhard disk images\u001b[0m: Specify the drive geometry as follows:\n\u001b[34;1mimgmount [DOS drive letter] [\"Path/to/image.img\"] -size [bps,spc,hpc,cyl]\u001b[0m\nbps = Bytes per sector\nspc = Sectors per cylinder\nhpc = Heads per cylinder\ncyl = Number of cylinders\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para \u001b[33mimÃ¡genes de CD-ROM:\u001b[0m    \u001b[34;1mimgmount [letra de unidad DOS] [\"ruta/a/imagen.iso\"] -t iso\u001b[0m\n\nPara \u001b[33mimÃ¡genes de disco duro\u001b[0m: Especifique la geometrÃ­a de la unidad como a continuaciÃ³n:\n\u001b[34;1mimgmount [letra de unidad DOS] [\"ruta/a/imagen.img\"] -size [bps,spc,hpc,cyl]\u001b[0m\nbps = Bytes por sector\nspc = Sectores por cilindro\nhpc = Cabezales por cilindro\ncyl = NÃºmero de cilindros\n"
          }
