    "PROGRAM_INTRO": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mWelcome to DOSBox\u001b[0m, an x86 emulator with sound and graphics.\nDOSBox creates a shell for you which looks like old plain DOS.\n\nFor information about basic mount type \u001b[34;1mintro mount\u001b[0m\nFor information about CD-ROM support type \u001b[34;1mintro cdrom\u001b[0m\nFor information about special keys type \u001b[34;1mintro special\u001b[0m\nFor more information about DOSBox, go to \u001b[34;1mhttp:\n\n\u001b[31;1mDOSBox will stop/exit without a warning if an error occurred!\u001b[0m\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mBienvenue dans DOSBox\u001b[0m, un Ã©mulateur x86 avec son et graphismes.\nDOSBox crÃ©e pour vous un shell qui ressemble Ã  un ancien DOS ordinaire.\n\nPour des informations sur le montage de base, tapez \u001b[34;1mintro mount\u001b[0m\nPour des informations sur le support CD-ROM, tapez \u001b[34;1mintro cdrom\u001b[0m\nPour des informations sur les touches spÃ©ciales, tapez \u001b[34;1mintro special\u001b[0m\nPour plus d'informations sur DOSBox, visitez \u001b[34;1mhttp:\n\n\u001b[31;1mDOSBox se fermera sans afficher d'avertissement si une erreur se produit !\u001b[0m\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mWelcome to DOSBox\u001b[0m, an x86 emulator with sound and graphics.\nDOSBox creates a shell for you which looks like old plain DOS.\n\nFor information about basic mount type \u001b[34;1mintro mount\u001b[0m\nFor information about CD-ROM support type \u001b[34;1mintro cdrom\u001b[0m\nFor information about special keys type \u001b[34;1mintro special\u001b[0m\nFor more information about DOSBox, go to \u001b[34;1mhttp:\n\n\u001b[31;1mDOSBox will stop/exit without a warning if an error occurred!\u001b[0m\n"
          }
        }
      }
    },
    "PROGRAM_INTRO_MOUNT_START": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[32;1mHere are some commands to get you started:\u001b[0m\nBefore you can use the files located on your own filesystem,\nYou have to mount the directory containing the files.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[32;1mVoici quelques commandes pour vous aider Ã  dÃ©marrer :\u001b[0m\nAvant de pouvoir utiliser les fichiers situÃ©s sur vos propres systÃ¨mes de\nfichiers, vous devez monter le rÃ©pertoire contenant les fichiers.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[32;1mHere are some commands to get you started:\u001b[0m\nBefore you can use the files located on your own filesystem,\nYou have to mount the directory containing the files.\n"
          }
        }
      }
    },
    "PROGRAM_INTRO_MOUNT_OTHER": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[44;1mââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\nâ \u001b[32mmount c ~/dosgames\u001b[37m will create a C drive with ~/dosgames as contents.â\nâ                                                                      â\nâ \u001b[32m~/dosgames\u001b[37m is an example. Replace it with your own games directory.\u001b[37m  â\nââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\u001b[0m\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[44;1mââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\nâ \u001b[32mmount c ~/jeuxdos\u001b[37m crÃ©era un lecteur C avec le contenu de ~/jeuxdos   â\nâ                                                                      â\nâ \u001b[32m~/jeuxdos\u001b[37m est un exemple. Remplacez-le par votre propre rÃ©pertoire.\u001b[37m  â\nââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\u001b[0m\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[44;1mââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\nâ \u001b[32mmount c ~/dosgames\u001b[37m will create a C drive with ~/dosgames as contents.â\nâ                                                                      â\nâ \u001b[32m~/dosgames\u001b[37m is an example. Replace it with your own games directory.\u001b[37m  â\nââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ\u001b[0m\n"
          }
        }
      }
    },
    "PROGRAM_INTRO_MOUNT_END": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the mount has successfully completed you can type \u001b[34;1mc:\u001b[0m to go to your freshly\nmounted C-drive. Typing \u001b[34;1mdir\u001b[0m there will show its contents. \u001b[34;1mcd\u001b[0m will allow you to\nenter a directory (recognised by the \u001b[33;1m[]\u001b[0m in a directory listing).\nYou can run programs/files which end with \u001b[31m.exe .bat\u001b[0m and \u001b[31m.com\u001b[0m.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois le montage effectuÃ© avec succÃ¨s, vous pouvez taper \u001b[34;1mc:\u001b[0m pour atteindre\nvotre lecteur C nouvellement montÃ©. En tapant \u001b[34;1mdir\u001b[0m, vous afficherez son contenu.\nLa commande \u001b[34;1mcd\u001b[0m vous permettra d'entrer dans un rÃ©pertoire (reconnaissable dans\nla liste d'un rÃ©pertoire par \u001b[33;1m[]\u001b[0m). Vous pouvez exÃ©cuter des programmes/fichiers\ndont le nom se termine par \u001b[31m.exe .bat\u001b[0m et \u001b[31m.com\u001b[0m.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "When the mount has successfully completed you can type \u001b[34;1mc:\u001b[0m to go to your freshly\nmounted C-drive. Typing \u001b[34;1mdir\u001b[0m there will show its contents. \u001b[34;1mcd\u001b[0m will allow you to\nenter a directory (recognised by the \u001b[33;1m[]\u001b[0m in a directory listing).\nYou can run programs/files which end with \u001b[31m.exe .bat\u001b[0m and \u001b[31m.com\u001b[0m.\n"
          }
        }
      }
    },
    "PROGRAM_INTRO_CDROM": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mHow to mount a Real/Virtual CD-ROM Drive in DOSBox:\u001b[0m\nDOSBox provides CD-ROM emulation on several levels.\n\nThe \u001b[33mbasic\u001b[0m level works on all CD-ROM drives and normal directories.\nIt installs MSCDEX and marks the files read-only.\nUsually this is enough for most games:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom\u001b[0m   or   \u001b[34;1mmount d C:\\example -t cdrom\u001b[0m\nIf it doesn't work you might have to tell DOSBox the label of the CD-ROM:\n\u001b[34;1mmount d C:\\example -t cdrom -label CDLABEL\u001b[0m\n\nThe \u001b[33mnext\u001b[0m level adds some low-level support.\nTherefore only works on CD-ROM drives:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0\u001b[0m\n\nThe \u001b[33mlast\u001b[0m level of support depends on your Operating System:\nFor \u001b[1mWindows 2000\u001b[0m, \u001b[1mWindows XP\u001b[0m and \u001b[1mLinux\u001b[0m:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0 \u001b[34m-ioctl\u001b[0m\nFor \u001b[1mWindows 9x\u001b[0m with a ASPI layer installed:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0 \u001b[34m-aspi\u001b[0m\n\nReplace \u001b[0;31mD:\\\u001b[0m with the location of your CD-ROM.\nReplace the \u001b[33;1m0\u001b[0m in \u001b[34;1m-usecd \u001b[33m0\u001b[0m with the number reported for your CD-ROM if you type:\n\u001b[34;1mmount -cd\u001b[0m\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mComment monter un lecteur CD-ROM rÃ©el/virtuel dans DOSBox :\u001b[0m\nDOSBox fournit plusieurs niveaux d'Ã©mulation CD-ROM.\n\nLe niveau \u001b[33mbasic\u001b[0m fonctionne sur tous les lecteurs CD-ROM et rÃ©pertoires normaux.\nIl installe MSCDEX et marque les fichiers en lecture seule.\nHabituellement, cela suffit pour la plupart des jeux :\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom\u001b[0m   ou   \u001b[34;1mmount d C:\\exemple -t cdrom\u001b[0m\nSi cela ne fonctionne pas, vous dever indiquer Ã  DOSBox le label du CD-ROM :\n\u001b[34;1mmount d C:\\exemple -t cdrom -label LABELCD\u001b[0m\n\nLe niveau \u001b[33msuivant\u001b[0m supporte des fonctions supplÃ©mentaires de bas niveau.\nCela fonctionne donc uniquement sur les lecteurs CD-ROM :\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0\u001b[0m\n\nLe \u001b[33mdernier\u001b[0m niveau de support dÃ©pend de votre systÃ¨me d'exploitation :\nPour \u001b[1mWindows 2000\u001b[0m, \u001b[1mWindows XP\u001b[0m et \u001b[1mLinux\u001b[0m :\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0 \u001b[34m-ioctl\u001b[0m\nPour \u001b[1mWindows 9x\u001b[0m avec la couche ASPI installÃ©e :\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0 \u001b[34m-aspi\u001b[0m\n\nRemplacez \u001b[0;31mD:\\\u001b[0m par l'emplacement de votre CD-ROM.\nRemplacez le \u001b[33;1m0\u001b[0m dans \u001b[34;1m-usecd \u001b[33m0\u001b[0m par le numÃ©ro rapportÃ© pour votre CD-ROM\nen tapant : \u001b[34;1mmount -cd\u001b[0m\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mHow to mount a Real/Virtual CD-ROM Drive in DOSBox:\u001b[0m\nDOSBox provides CD-ROM emulation on several levels.\n\nThe \u001b[33mbasic\u001b[0m level works on all CD-ROM drives and normal directories.\nIt installs MSCDEX and marks the files read-only.\nUsually this is enough for most games:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom\u001b[0m   or   \u001b[34;1mmount d C:\\example -t cdrom\u001b[0m\nIf it doesn't work you might have to tell DOSBox the label of the CD-ROM:\n\u001b[34;1mmount d C:\\example -t cdrom -label CDLABEL\u001b[0m\n\nThe \u001b[33mnext\u001b[0m level adds some low-level support.\nTherefore only works on CD-ROM drives:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0\u001b[0m\n\nThe \u001b[33mlast\u001b[0m level of support depends on your Operating System:\nFor \u001b[1mWindows 2000\u001b[0m, \u001b[1mWindows XP\u001b[0m and \u001b[1mLinux\u001b[0m:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0 \u001b[34m-ioctl\u001b[0m\nFor \u001b[1mWindows 9x\u001b[0m with a ASPI layer installed:\n\u001b[34;1mmount d \u001b[0;31mD:\\\u001b[34;1m -t cdrom -usecd \u001b[33m0 \u001b[34m-aspi\u001b[0m\n\nReplace \u001b[0;31mD:\\\u001b[0m with the location of your CD-ROM.\nReplace the \u001b[33;1m0\u001b[0m in \u001b[34;1m-usecd \u001b[33m0\u001b[0m with the number reported for your CD-ROM if you type:\n\u001b[34;1mmount -cd\u001b[0m\n"
          }
        }
      }
    },
    "PROGRAM_INTRO_SPECIAL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mSpecial keys:\u001b[0m\nThese are the default keybindings.\nThey can be changed in the \u001b[33mkeymapper\u001b[0m.\n\n\u001b[33;1mALT-ENTER\u001b[0m   : Go full screen and back.\n\u001b[33;1mALT-PAUSE\u001b[0m   : Pause DOSBox.\n\u001b[33;1mCTRL-F1\u001b[0m     : Start the \u001b[33mkeymapper\u001b[0m.\n\u001b[33;1mCTRL-F4\u001b[0m     : Update directory cache for all drives! Swap mounted disk-image.\n\u001b[33;1mCTRL-ALT-F5\u001b[0m : Start/Stop creating a movie of the screen.\n\u001b[33;1mCTRL-F5\u001b[0m     : Save a screenshot.\n\u001b[33;1mCTRL-F6\u001b[0m     : Start/Stop recording sound output to a wave file.\n\u001b[33;1mCTRL-ALT-F7\u001b[0m : Start/Stop recording of OPL commands.\n\u001b[33;1mCTRL-ALT-F8\u001b[0m : Start/Stop the recording of raw MIDI commands.\n\u001b[33;1mCTRL-F7\u001b[0m     : Decrease frameskip.\n\u001b[33;1mCTRL-F8\u001b[0m     : Increase frameskip.\n\u001b[33;1mCTRL-F9\u001b[0m     : Kill DOSBox.\n\u001b[33;1mCTRL-F10\u001b[0m    : Capture/Release the mouse.\n\u001b[33;1mCTRL-F11\u001b[0m    : Slow down emulation (Decrease DOSBox Cycles).\n\u001b[33;1mCTRL-F12\u001b[0m    : Speed up emulation (Increase DOSBox Cycles).\n\u001b[33;1mALT-F12\u001b[0m     : Unlock speed (turbo button/fast forward).\n\n\u001b[31;1mNOTE\u001b[0m: These may be different under Boxer!\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mTouches spÃ©ciales :\u001b[0m\nVoici les raccourcis clavier par dÃ©faut.\nIls peuvent Ãªtre modifiÃ©s dans le \u001b[33mmappeur de touches\u001b[0m.\n\n\u001b[33;1mALT-ENTRÃE\u001b[0m  : Permute le mode plein Ã©cran.\n\u001b[33;1mALT-PAUSE\u001b[0m   : Met en pause DOSBox.\n\u001b[33;1mCTRL-F1\u001b[0m     : DÃ©marre le \u001b[33mmappeur de touches\u001b[0m.\n\u001b[33;1mCTRL-F4\u001b[0m     : Met Ã  jour cache des rÃ©pertoires ! Ãchange l'image disque montÃ©e.\n\u001b[33;1mCTRL-ALT-F5\u001b[0m : DÃ©marre/arrÃªte la crÃ©ation d'une sÃ©quence vidÃ©o de l'Ã©cran.\n\u001b[33;1mCTRL-F5\u001b[0m     : Enregistre une capture d'Ã©cran.\n\u001b[33;1mCTRL-F6\u001b[0m     : DÃ©marre/arrÃªte l'enreg. des sorties sonores vers un fichier wave.\n\u001b[33;1mCTRL-ALT-F7\u001b[0m : DÃ©marre/arrÃªte l'enregistrement des commandes OPL.\n\u001b[33;1mCTRL-ALT-F8\u001b[0m : DÃ©marre/arrÃªte l'enregistrement des commandes MIDI brutes.\n\u001b[33;1mCTRL-F7\u001b[0m     : Diminue le saut d'images.\n\u001b[33;1mCTRL-F8\u001b[0m     : Augmente le saut d'images.\n\u001b[33;1mCTRL-F9\u001b[0m     : Tue DOSBox.\n\u001b[33;1mCTRL-F10\u001b[0m    : Capture/libÃ¨re la souris.\n\u001b[33;1mCTRL-F11\u001b[0m    : Ralentit l'Ã©mulation (diminue les cycles DOSBox).\n\u001b[33;1mCTRL-F12\u001b[0m    : AccÃ©lÃ¨re l'Ã©mulation (augmente les cycles DOSBox).\n\u001b[33;1mALT-F12\u001b[0m     : DÃ©bloque la vitesse (bouton turbo/avance rapide).\n\n\u001b[31;1mREMARQUE\u001b[0m : Ils peuvent Ãªtre diffÃ©rents sous Boxer !\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[2J\u001b[32;1mSpecial keys:\u001b[0m\nThese are the default keybindings.\nThey can be changed in the \u001b[33mkeymapper\u001b[0m.\n\n\u001b[33;1mALT-ENTER\u001b[0m   : Go full screen and back.\n\u001b[33;1mALT-PAUSE\u001b[0m   : Pause DOSBox.\n\u001b[33;1mCTRL-F1\u001b[0m     : Start the \u001b[33mkeymapper\u001b[0m.\n\u001b[33;1mCTRL-F4\u001b[0m     : Update directory cache for all drives! Swap mounted disk-image.\n\u001b[33;1mCTRL-ALT-F5\u001b[0m : Start/Stop creating a movie of the screen.\n\u001b[33;1mCTRL-F5\u001b[0m     : Save a screenshot.\n\u001b[33;1mCTRL-F6\u001b[0m     : Start/Stop recording sound output to a wave file.\n\u001b[33;1mCTRL-ALT-F7\u001b[0m : Start/Stop recording of OPL commands.\n\u001b[33;1mCTRL-ALT-F8\u001b[0m : Start/Stop the recording of raw MIDI commands.\n\u001b[33;1mCTRL-F7\u001b[0m     : Decrease frameskip.\n\u001b[33;1mCTRL-F8\u001b[0m     : Increase frameskip.\n\u001b[33;1mCTRL-F9\u001b[0m     : Kill DOSBox.\n\u001b[33;1mCTRL-F10\u001b[0m    : Capture/Release the mouse.\n\u001b[33;1mCTRL-F11\u001b[0m    : Slow down emulation (Decrease DOSBox Cycles).\n\u001b[33;1mCTRL-F12\u001b[0m    : Speed up emulation (Increase DOSBox Cycles).\n\u001b[33;1mALT-F12\u001b[0m     : Unlock speed (turbo button/fast forward).\n\n\u001b[31;1mNOTE\u001b[0m: These may be different under Boxer!\n"
          }
        }
      }
    },
    "SHELL_CMD_MOUNT_HELP_LONG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount a directory from the host OS to a drive letter.\n\nUsage:\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mDRIVE\u001b[0m \u001b[36;1mDIRECTORY\u001b[0m [-t TYPE] [-freesize SIZE] [-label LABEL]\n  \u001b[32;1mmount\u001b[0m -u \u001b[37;1mDRIVE\u001b[0m  (unmounts the DRIVE's directory)\n\nWhere:\n  \u001b[37;1mDRIVE\u001b[0m     the drive letter where the directory will be mounted: A, C, D, ...\n  \u001b[36;1mDIRECTORY\u001b[0m is the directory on the host OS to be mounted\n  TYPE      type of the directory to mount: dir, floppy, cdrom, or overlay\n  SIZE      free space for the virtual drive (KiB for floppies, MiB otherwise)\n  LABEL     drive label name to be used\n\nNotes:\n  - '-t overlay' redirects writes for mounted drive to another directory.\n  - Additional options are described in the manual (README file, chapter 4).\n\nExamples:\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1m~/dosgames\u001b[0m\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mD\u001b[0m \u001b[36;1m\"/Volumes/Game CD\"\u001b[0m -t cdrom\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1mmy_savegame_files\u001b[0m -t overlay\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount a directory from the host OS to a drive letter.\n\nUsage:\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mDRIVE\u001b[0m \u001b[36;1mDIRECTORY\u001b[0m [-t TYPE] [-freesize SIZE] [-label LABEL]\n  \u001b[32;1mmount\u001b[0m -u \u001b[37;1mDRIVE\u001b[0m  (unmounts the DRIVE's directory)\n\nWhere:\n  \u001b[37;1mDRIVE\u001b[0m     the drive letter where the directory will be mounted: A, C, D, ...\n  \u001b[36;1mDIRECTORY\u001b[0m is the directory on the host OS to be mounted\n  TYPE      type of the directory to mount: dir, floppy, cdrom, or overlay\n  SIZE      free space for the virtual drive (KiB for floppies, MiB otherwise)\n  LABEL     drive label name to be used\n\nNotes:\n  - '-t overlay' redirects writes for mounted drive to another directory.\n  - Additional options are described in the manual (README file, chapter 4).\n\nExamples:\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1m~/dosgames\u001b[0m\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mD\u001b[0m \u001b[36;1m\"/Volumes/Game CD\"\u001b[0m -t cdrom\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1mmy_savegame_files\u001b[0m -t overlay\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte un rÃ©pertoire de l'OS hÃ´te vers une lettre de lecteur.\n\nUsage :\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mLECTEUR\u001b[0m \u001b[36;1mRÃP\u001b[0m [-t TYPE] [-freesize TAILLE] [-label LABEL]\n  \u001b[32;1mmount\u001b[0m -u \u001b[37;1mLECTEUR\u001b[0m  (dÃ©monte le rÃ©pertoire de LECTEUR)\n\nOÃ¹ :\n  \u001b[37;1mLECTEUR\u001b[0m la lettre de lecteur oÃ¹ le rÃ©pertoire sera montÃ© : A, C, D...\n  \u001b[36;1mRÃP\u001b[0m     est le rÃ©pertoire de l'OS Ã  monter\n  TYPE    type du rÃ©pertoire Ã  monter : dir, floppy, cdrom, ou overlay\n  TAILLE  espace libre du disque virtuel (Kio pour les disquettes, Mio sinon)\n  LABEL   nom du label de lecteur Ã  utiliser\n\nRemarques :\n  - '-t overlay' redirige les Ã©critures sur le lecteur montÃ© vers un autre rÃ©p.\n  - Plus d'options sont dÃ©crites dans le manuel (fichier LISEZMOI, chapitre 4).\n\nExemples :\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1m~/jeuxdos\u001b[0m\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mD\u001b[0m \u001b[36;1m\"/Volumes/CD jeu\"\u001b[0m -t cdrom\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1mmes_sauvegardes\u001b[0m -t overlay\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mount a directory from the host OS to a drive letter.\n\nUsage:\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mDRIVE\u001b[0m \u001b[36;1mDIRECTORY\u001b[0m [-t TYPE] [-freesize SIZE] [-label LABEL]\n  \u001b[32;1mmount\u001b[0m -u \u001b[37;1mDRIVE\u001b[0m  (unmounts the DRIVE's directory)\n\nWhere:\n  \u001b[37;1mDRIVE\u001b[0m     the drive letter where the directory will be mounted: A, C, D, ...\n  \u001b[36;1mDIRECTORY\u001b[0m is the directory on the host OS to be mounted\n  TYPE      type of the directory to mount: dir, floppy, cdrom, or overlay\n  SIZE      free space for the virtual drive (KiB for floppies, MiB otherwise)\n  LABEL     drive label name to be used\n\nNotes:\n  - '-t overlay' redirects writes for mounted drive to another directory.\n  - Additional options are described in the manual (README file, chapter 4).\n\nExamples:\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1m~/dosgames\u001b[0m\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mD\u001b[0m \u001b[36;1m\"/Volumes/Game CD\"\u001b[0m -t cdrom\n  \u001b[32;1mmount\u001b[0m \u001b[37;1mC\u001b[0m \u001b[36;1mmy_savegame_files\u001b[0m -t overlay\n"
          }
        }
      }
    },
