    "SHELL_CMD_RENAME_HELP_LONG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mmove [path/to/file] [path/to/destination]\u001b[0m\n          -or-\n          \u001b[34;1mmove/rename [filename] [newname]\u001b[0m\n\nExamples: \u001b[32;1mmove d:/game.exe c:/games/\u001b[0m will move \"game.exe\" from drive D\n          to the \"games\" folder of drive C.\n\t\t  \n          \u001b[32;1mmove\u001b[0m (or \u001b[32;1mrename\u001b[0m) \u001b[32;1mold.exe new.exe\u001b[0m will rename\n          \"old.exe\" to \"new.exe\".\n\t\t  \n          \u001b[32;1mmove d:/old.exe c:/games/new.exe\u001b[0m will move \"old.exe\" from drive D\n          to the \"games\" folder of drive C and rename it to \"new.exe\".\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso:      \u001b[34;1mmove [ruta/a/archivo] [ruta/a/destino]\u001b[0m\n          -o-\n          \u001b[34;1mmove/rename [nombre de archivo] [nuevo nombre]\u001b[0m\n\nEjemplos: \u001b[32;1mmove d:/game.exe c:/games/\u001b[0m moverÃ¡ \"game.exe\" desde la unidad D\n          a la carpeta \"games\" de la unidad C.\n\t\t  \n          \u001b[32;1mmove\u001b[0m (o \u001b[32;1mrename\u001b[0m) \u001b[32;1mold.exe new.exe\u001b[0m renombrarÃ¡ \"old.exe\" a \"new.exe\".\n\t\t  \n          \u001b[32;1mmove d:/old.exe c:/games/new.exe\u001b[0m moverÃ¡ \"old.exe\" desde la unidad D\n          a la carpeta \"games\" de la unidad C y renombrarÃ¡ a \"new.exe\".\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage :    \u001b[34;1mmove [chemin/du/fichier] [chemin/de/destination]\u001b[0m\n\t\t   -ou-\n\t\t   \u001b[34;1mmove/rename [nomfichier] [nouveaunom]\u001b[0m\n\nExemples : \u001b[32;1mmove d:/jeu.exe c:/jeux/\u001b[0m dÃ©placera \"jeu.exe\" du lecteur D\n\t\t   vers le dossier \"jeux\" du lecteur C.\n\n\t\t   \u001b[32;1mmove\u001b[0m (ou \u001b[32;1mrename\u001b[0m) \u001b[32;1mancien.exe nouveau.exe\u001b[0m renommera \"ancien.exe\"\n\t\t   en \"nouveau.exe\".\n\n\t\t   \u001b[32;1mmove d:/ancien.exe c:/jeux/nouveau.exe\u001b[0m dÃ©placera \"ancien.exe\"\n\t\t   du lecteur D vers le dossier \"jeux\" du lecteur C et le renommera\n\t\t   en \"nouveau.exe\".\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mmove [path/to/file] [path/to/destination]\u001b[0m\n          -or-\n          \u001b[34;1mmove/rename [filename] [newname]\u001b[0m\n\nExamples: \u001b[32;1mmove d:/game.exe c:/games/\u001b[0m will move \"game.exe\" from drive D\n          to the \"games\" folder of drive C.\n\t\t  \n          \u001b[32;1mmove\u001b[0m (or \u001b[32;1mrename\u001b[0m) \u001b[32;1mold.exe new.exe\u001b[0m will rename\n          \"old.exe\" to \"new.exe\".\n\t\t  \n          \u001b[32;1mmove d:/old.exe c:/games/new.exe\u001b[0m will move \"old.exe\" from drive D\n          to the \"games\" folder of drive C and rename it to \"new.exe\".\n"
          }
        }
      }
    },
