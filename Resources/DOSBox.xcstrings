    "SHELL_STARTUP_BEGIN" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\u001b[30;1m═══════════════════════════════ \u001b[0;37mWelcome to Boxer\u001b[30;1m ═══════════════════════════════\n  \u001b[37m\u001b If you're new to DOS, type \u001b[33mhelp\u001b[37m for some helpful DOS commands.\n  For tips, games and updates, visit the \u001b[34mBoxer Website\u001b[37m from the Help menu.\n\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\u001b[30;1m═══════════════════════════════ \u001b[0;37mBienvenido a Boxer\u001b[30;1m ═════════════════════════════\n  \u001b[37m\u001b Si es nuevo en DOS, escriba \u001b[33mhelp\u001b[37m para algunos comandos DOS útiles.\n  Para consejos, juegos y actualizaciones, visite la \u001b[34mpágina web de Boxer\u001b[37m\n  desde el menú Ayuda.\n\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\u001b[30;1m═════════════════════════════ \u001b[0;37mBienvenue dans Boxer\u001b[30;1m ═════════════════════════════\n  \u001b[37m\u001b Si vous débutez avec DOS, tapez \u001b[33mhelp\u001b[37m pour voir quelques commandes DOS utiles.\n  Pour obtenir plus d'infos, visitez le \u001b[34msite web Boxer\u001b[37m à partir du menu Aide.\n\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\u001b[30;1m═══════════════════════════════ \u001b[0;37mWelcome to Boxer\u001b[30;1m ═══════════════════════════════\n  \u001b[37m\u001b If you're new to DOS, type \u001b[33mhelp\u001b[37m for some helpful DOS commands.\n  For tips, games and updates, visit the \u001b[34mBoxer Website\u001b[37m from the Help menu.\n\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\u001b[30;1m═══════════════════════════════ \u001b[0;37mWelcome to Boxer\u001b[30;1m ═══════════════════════════════\n  \u001b[37m\u001b If you're new to DOS, type \u001b[33mhelp\u001b[37m for some helpful DOS commands.\n  For tips, games and updates, visit the \u001b[34mBoxer Website\u001b[37m from the Help menu.\n\n"
          }
        }
      }
    },
    "SHELL_STARTUP_CGA" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Use \u001b[31mF12\u001b[37m to set composite output ON, OFF, or AUTO (default).\n  \u001b[31m(Alt-)F11\u001b[37m changes hue; \u001b[31mctrl-alt-F11\u001b[37m selects early/late CGA model.\n"
