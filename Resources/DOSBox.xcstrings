    "SHELL_CMD_DIR_HELP_LONG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mdir [/p]\u001b[0m\n          \u001b[34;1mdir [foldername] [/p]\u001b[0m\nExamples: \u001b[32;1mdir\u001b[0m        Displays the contents of the current folder.\n          \u001b[32;1mdir games\u001b[0m  Displays the contents of the \"games\" subfolder.\n\t\t  \nTo pause between each screenful of files, add \u001b[32;/p\u001b[0m to the command.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso:      \u001b[34;1mdir [/p]\u001b[0m\n          \u001b[34;1mdir [nombre de carpeta] [/p]\u001b[0m\nEjemplos: \u001b[32;1mdir\u001b[0m        Muestra el contenido de la carpeta actual.\n          \u001b[32;1mdir games\u001b[0m  Muestra el contenido de la subcarpeta \"games\".\n\t\t  \nPara hacer una pausa entre cada pantalla de archivos, aÃ±ada \u001b[32;1m/p\u001b[0m al comando.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage :    \u001b[34;1mdir [/p]\u001b[0m\n\t\t   \u001b[34;1mdir [nomdossier] [/p]\u001b[0m\nExemples : \u001b[32;1mdir\u001b[0m       Affiche le contenu du dossier en cours.\n\t\t   \u001b[32;1mdir jeux\u001b[0m  Affiche le contenu du sous-dossier \"jeux\".\n\t\t  \nPour marquer une pause entre chaque Ã©cran, ajoutez \u001b[32;1m/p\u001b[0m Ã  la commande.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mdir [/p]\u001b[0m\n          \u001b[34;1mdir [foldername] [/p]\u001b[0m\nExamples: \u001b[32;1mdir\u001b[0m        Displays the contents of the current folder.\n          \u001b[32;1mdir games\u001b[0m  Displays the contents of the \"games\" subfolder.\n\t\t  \nTo pause between each screenful of files, add \u001b[32;/p\u001b[0m to the command.\n"
          }
        }
      }
    },
