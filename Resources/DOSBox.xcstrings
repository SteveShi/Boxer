    "SHELL_CMD_DATE_HELP_LONG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DATE [[/T] [/H] [/S] | MM-DD-YYYY]\n  MM-DD-YYYY: new date to set\n  /S:         Permanently use host time and date as DOS time\n  /F:         Switch back to DOSBox internal time (opposite of /S)\n  /T:         Only display date\n  /H:         Synchronize with host\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DATE [[/T] [/H] [/S] | MM-JJ-AAAA]\n  MM-JJ-AAAA: Nouvelle date Ã  configurer\n  /S:         Utilise l'heure et la date de l'hÃ´te pour l'heure de DOS\n  /F:         Retourne Ã  l'heure interne de DOSBox (opposÃ© de /S)\n  /T:         Affiche uniquement la date\n  /H:         Synchronise avec l'hÃ´te\n"
          }
        },
