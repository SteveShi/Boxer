    "SHELL_CMD_CHDIR_HELP_LONG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mcd [path/to/folder]\u001b[0m\n          \u001b[34;1mcd ..\u001b[0m\nExamples: \u001b[32;1mcd games\u001b[0m Changes to the \"games\" subfolder in the current folder.\n          \u001b[32;1mcd ..\u001b[0m    Changes to the parent folder.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso:      \u001b[34;1mcd [ruta/a/carpeta]\u001b[0m\n          \u001b[34;1mcd ..\u001b[0m\nEjemplos: \u001b[32;1mcd games\u001b[0m Cambia a la subcarpeta \"games\" en la carpeta actual.\n          \u001b[32;1mcd ..\u001b[0m    Cambia a la carpeta principal.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage :    \u001b[34;1mcd [chemin/du/dossier]\u001b[0m\n\t\t   \u001b[34;1mcd ..\u001b[0m\nExemples : \u001b[32;1mcd jeux\u001b[0m  Modifie le dossier en cours vers le dossier \"jeux\".\n\t\t   \u001b[32;1mcd ..\u001b[0m    Modifie le dossier en cours vers le dossier parent.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:    \u001b[34;1mcd [path/to/folder]\u001b[0m\n          \u001b[34;1mcd ..\u001b[0m\nExamples: \u001b[32;1mcd games\u001b[0m Changes to the \"games\" subfolder in the current folder.\n          \u001b[32;1mcd ..\u001b[0m    Changes to the parent folder.\n"
          }
        }
      }
    },
