    },
    "SHELL_CMD_CHOICE_HELP_LONG" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:   \u001b[34;1mchoice [/C:choices] [/N] [/S] [Prompt text]\u001b[0m\n\nOptions:\n  \u001b[32;1m/C:choices\u001b[0m   List of keys to choose from. Default is YN.\n  \u001b[32;1m/N\u001b[0m           Do not display the choices at end of prompt.\n  \u001b[32;1m/S\u001b[0m           Makes choices case-sensitive.\n  \u001b[32;1mPrompt text\u001b[0m  The text to display as a prompt to the user.\n\nThe order of the choices list determines the \u001b[34;1ERRORLEVEL\u001b[0m produced by each key,\nstarting from 1.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso:       \u001b[34;1mchoice [/C:letra] [/N] [/S] [Texto de símbolo]\u001b[0m\n\nOpciones:\n  \u001b[32;1m/C:letra\u001b[0m          Lista de teclas para elegir. Por defecto es YN.\n  \u001b[32;1m/N\u001b[0m                No muestra las opciones en el símbolo del sistema.\n  \u001b[32;1m/S\u001b[0m                Distingue letras entre mayúsculas y minúsculas.\n  \u001b[32;1mTexto de símbolo\u001b[0m  El texto para mostrar como símbolo del sistema al usuario.\n\nEl orden de la lista de letras determina el \u001b[34;1mERRORLEVEL\u001b[0m producido por cada tecla,a partir de 1.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage :   \u001b[34;1mchoice [/C:touches] [/N] [/S] [texte]\u001b[0m\n\nOptions :\n  \u001b[32;1m/C:touches\u001b[0m  Spécifie les touches configurables. Par défaut : YN.\n  \u001b[32;1m/N\u001b[0m          N'affiche pas les touches à la fin de l'invite.\n  \u001b[32;1m/S\u001b[0m          Permet de distinguer majuscules et minuscules.\n  \u001b[32;1mtexte\u001b[0m       Texte à afficher avant l'invite à l'utilisateur.\n\nL'ordre dans la liste des touches détermine la valeur de \u001b[34;1ERRORLEVEL\u001b[0m produit\npar chaque touche, en partant de 1.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:   \u001b[34;1mchoice [/C:choices] [/N] [/S] [Prompt text]\u001b[0m\n\nOptions:\n  \u001b[32;1m/C:choices\u001b[0m   List of keys to choose from. Default is YN.\n  \u001b[32;1m/N\u001b[0m           Do not display the choices at end of prompt.\n  \u001b[32;1m/S\u001b[0m           Makes choices case-sensitive.\n  \u001b[32;1mPrompt text\u001b[0m  The text to display as a prompt to the user.\n\nThe order of the choices list determines the \u001b[34;1ERRORLEVEL\u001b[0m produced by each key,\nstarting from 1.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage:   \u001b[34;1mchoice [/C:choices] [/N] [/S] [Prompt text]\u001b[0m\n\nOptions:\n  \u001b[32;1m/C:choices\u001b[0m   List of keys to choose from. Default is YN.\n  \u001b[32;1m/N\u001b[0m           Do not display the choices at end of prompt.\n  \u001b[32;1m/S\u001b[0m           Makes choices case-sensitive.\n  \u001b[32;1mPrompt text\u001b[0m  The text to display as a prompt to the user.\n\nThe order of the choices list determines the \u001b[34;1ERRORLEVEL\u001b[0m produced by each key,\nstarting from 1.\n"
          }
        }
      }
    },
