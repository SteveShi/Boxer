    "PROGRAM_KEYB_SHOWHELP" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u001b[34;1mkeyb [keyboard layout ID] [codepage number] [codepage file]\u001b[0m\n\nExamples:\n  \u001b[32;1mkeyb\u001b[0m: Display currently loaded laout.\n  \u001b[32;1mkeyb\u001b[0m sp: Load the spanish layout with an automatic codepage.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Load the spanish layout with codepage 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Same as above, but load the codepage from the file mycp.cpi.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u001b[34;1mkeyb [distribución de teclado] [código de página] [archivo de código de página]\u001b[0m\n\nEjemplos:\n  \u001b[32;1mkeyb\u001b[0m: Muestra la distribución actualmente cargada.\n  \u001b[32;1mkeyb\u001b[0m sp: Carga la distribución española con el código de página automático.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Carga la distribución española con el código de página 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Igual que el anterior, pero carga el código de página\n  desde el archivo mycp.cpi.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u001b[34;1mkeyb [ID disposition clavier] [numéro page de codes] [fichier page de codes]\u001b[0m\n\nExemples :\n  \u001b[32;1mkeyb\u001b[0m : Affiche la disposition actuellement chargée.\n  \u001b[32;1mkeyb\u001b[0m fr : Charge la disposition française avec une page de codes automatique.\n  \u001b[32;1mkeyb\u001b[0m fr 850 : Charge la disposition française avec la page de codes 850.\n  \u001b[32;1mkeyb\u001b[0m fr 850 mycp.cpi : Charge la page de codes à partir du fichier mycp.cpi.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u001b[34;1mkeyb [keyboard layout ID] [codepage number] [codepage file]\u001b[0m\n\nExamples:\n  \u001b[32;1mkeyb\u001b[0m: Display currently loaded laout.\n  \u001b[32;1mkeyb\u001b[0m sp: Load the spanish layout with an automatic codepage.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Load the spanish layout with codepage 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Same as above, but load the codepage from the file mycp.cpi.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\u001b[34;1mkeyb [keyboard layout ID] [codepage number] [codepage file]\u001b[0m\n\nExamples:\n  \u001b[32;1mkeyb\u001b[0m: Display currently loaded laout.\n  \u001b[32;1mkeyb\u001b[0m sp: Load the spanish layout with an automatic codepage.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Load the spanish layout with codepage 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Same as above, but load the codepage from the file mycp.cpi.\n"
          }
        }
      }
    },
