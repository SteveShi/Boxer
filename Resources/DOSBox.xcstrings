    "PROGRAM_KEYB_SHOWHELP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[34;1mkeyb [keyboard layout ID] [codepage number] [codepage file]\u001b[0m\n\nExamples:\n  \u001b[32;1mkeyb\u001b[0m: Display currently loaded laout.\n  \u001b[32;1mkeyb\u001b[0m sp: Load the spanish layout with an automatic codepage.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Load the spanish layout with codepage 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Same as above, but load the codepage from the file mycp.cpi.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[34;1mkeyb [distribuciÃ³n de teclado] [cÃ³digo de pÃ¡gina] [archivo de cÃ³digo de pÃ¡gina]\u001b[0m\n\nEjemplos:\n  \u001b[32;1mkeyb\u001b[0m: Muestra la distribuciÃ³n actualmente cargada.\n  \u001b[32;1mkeyb\u001b[0m sp: Carga la distribuciÃ³n espaÃ±ola con el cÃ³digo de pÃ¡gina automÃ¡tico.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Carga la distribuciÃ³n espaÃ±ola con el cÃ³digo de pÃ¡gina 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Igual que el anterior, pero carga el cÃ³digo de pÃ¡gina\n  desde el archivo mycp.cpi.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[34;1mkeyb [ID disposition clavier] [numÃ©ro page de codes] [fichier page de codes]\u001b[0m\n\nExemples :\n  \u001b[32;1mkeyb\u001b[0m : Affiche la disposition actuellement chargÃ©e.\n  \u001b[32;1mkeyb\u001b[0m fr : Charge la disposition franÃ§aise avec une page de codes automatique.\n  \u001b[32;1mkeyb\u001b[0m fr 850 : Charge la disposition franÃ§aise avec la page de codes 850.\n  \u001b[32;1mkeyb\u001b[0m fr 850 mycp.cpi : Charge la page de codes Ã  partir du fichier mycp.cpi.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u001b[34;1mkeyb [keyboard layout ID] [codepage number] [codepage file]\u001b[0m\n\nExamples:\n  \u001b[32;1mkeyb\u001b[0m: Display currently loaded laout.\n  \u001b[32;1mkeyb\u001b[0m sp: Load the spanish layout with an automatic codepage.\n  \u001b[32;1mkeyb\u001b[0m sp 850: Load the spanish layout with codepage 850.\n  \u001b[32;1mkeyb\u001b[0m sp 850 mycp.cpi: Same as above, but load the codepage from the file mycp.cpi.\n"
          }
        }
      }
    },
